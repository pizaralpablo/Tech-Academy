FROM postgres:16-alpine

# Las credenciales (POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB) ya no se
# hardcodean aqui: se inyectan en tiempo de despliegue mediante el Secret
# jonathan-db-secret (ver k8s/db-secret.yaml y k8s/db-statefulset.yaml).

COPY init.sql /docker-entrypoint-initdb.d/init.sql

EXPOSE 5432
