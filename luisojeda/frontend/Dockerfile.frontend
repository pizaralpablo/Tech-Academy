FROM alpine:3.24.2 AS build

WORKDIR /app

COPY index.html .

COPY styles.css .

COPY app.js .

COPY users.html .

COPY users.js .

COPY nginx.conf .

FROM nginx:1.27-alpine AS final

RUN adduser -D -u 8888 -G nginx webappuser && rm -f /usr/share/nginx/html/*

RUN mkdir -p /var/cache/nginx \
    && chown -R webappuser:nginx /var/cache/nginx /usr/share/nginx/html \
    && chown -R webappuser:nginx /etc/nginx

USER webappuser

COPY --from=build /app/index.html /usr/share/nginx/html/index.html

COPY --from=build /app/styles.css /usr/share/nginx/html/styles.css

COPY --from=build /app/app.js /usr/share/nginx/html/app.js

COPY --from=build /app/users.html /usr/share/nginx/html/users.html

COPY --from=build /app/users.js /usr/share/nginx/html/users.js

COPY --from=build /app/nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
