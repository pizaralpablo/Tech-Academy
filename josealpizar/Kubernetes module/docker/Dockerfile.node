# Primera etapa: prepara los archivos que usara la aplicacion Node.js.
FROM node:22-alpine AS build

# Define /app como directorio de trabajo dentro de esta etapa.
WORKDIR /app

# Copia la definicion de dependencias desde el contexto de Docker.
COPY package.json ./

# Instala las dependencias que usara la API en la imagen final.
RUN npm install --omit=dev

# Copia la pagina web y el servidor Node desde el contexto de Docker.
COPY index.html server.js ./

# Segunda etapa: crea la imagen final que ejecutara el servidor.
FROM node:22-alpine AS runtime

# Define /app como directorio de trabajo de la imagen final.
WORKDIR /app

# Copia la aplicacion y sus dependencias desde la etapa build.
# Tambien asigna su propiedad al usuario no privilegiado node.
COPY --from=build --chown=node:node /app/package.json /app/index.html /app/server.js ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules

# Ejecuta el contenedor con el usuario node en lugar de root.
USER node

# Documenta que el servidor escucha en el puerto 8080.
EXPOSE 8080

# Inicia el servidor HTTP cuando arranca el contenedor.
CMD ["node", "server.js"]
